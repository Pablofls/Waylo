REALTIME_HOST=127.0.0.1
REALTIME_PORT=5950
# Debe ser el mismo valor que usa Next.js para firmar los tokens (32+ bytes aleatorios).
WS_JWT_SECRET=
# Rol waylo_app, con search_path=waylo,public (ver db/.env.example). Si falta, no se valida la
# rodada ni se guarda el historial (solo desarrollo).
DATABASE_URL=
# Solo para la prueba de integración (normalmente la misma URL que DATABASE_URL).
TEST_DATABASE_URL=
