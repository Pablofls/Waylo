# Base de datos de Waylo (solo la parte de db/). Copia a un archivo fuera de Git (por ejemplo
# /etc/waylo/migrator.env con permisos 600) y escribe la contraseña real ahí, nunca en el repositorio.

# Rol dueño del esquema: migraciones y DDL (lo usa db/apply.sh y deploy.sh).
MIGRATOR_DATABASE_URL=postgresql://waylo_user:CAMBIA_ESTA_1@127.0.0.1:5432/waylo_db

# Rol de la aplicación: solo SELECT/INSERT/UPDATE/DELETE. Lo usan Next.js y el servicio Flask.
# Incluye search_path para no calificar cada tabla con "waylo.".
DATABASE_URL=postgresql://waylo_app:CAMBIA_ESTA_2@127.0.0.1:5432/waylo_db?options=-c%20search_path%3Dwaylo%2Cpublic
