# Produccion de Waylo. Sin secretos: los valores reales viven en /etc/waylo/waylo.env.
# Se carga tambien al hacer `next build` (las NEXT_PUBLIC_* se incrustan al construir).
WEB_PORT=3100
REALTIME_HOST=127.0.0.1
REALTIME_PORT=5950
DATABASE_URL=postgres://waylo_app:CAMBIAR@127.0.0.1:5432/waylo_db
WS_JWT_SECRET=CAMBIAR
SESSION_SECRET=CAMBIAR
NEXT_PUBLIC_WS_URL=wss://34-51-108-167.sslip.io/ws
NEXT_PUBLIC_MAPTILER_KEY=
# Carpeta de fotos de reportes (fuera del repositorio; ver docs/vm-setup.md).
UPLOADS_DIR=/var/lib/waylo/uploads
# Dirección pública de la app.
APP_URL=https://34-51-108-167.sslip.io
