# Llave de MapTiler (https://cloud.maptiler.com/account/keys/).
# Si se deja vacía, el mapa usa un estilo de respaldo gratuito (OpenFreeMap).
NEXT_PUBLIC_MAPTILER_KEY=

# Llave de OpenRouteService (https://openrouteservice.org/dev/#/signup) para calcular rutas en bici.
# Si se deja vacía, el mapa solo muestra las rutas ya calculadas y avisa que el motor no está configurado.
ORS_API_KEY=
